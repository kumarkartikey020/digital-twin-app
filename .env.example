# ══════════════════════════════════════════════════════════════════════════════
# DIGITAL TWIN VERSE — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ══════════════════════════════════════════════════════════════════════════════

# ── 1. General & Server Config ────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
PUBLIC_BASE_URL=https://digitaltwinvrs.com

# ── 2. Database Config (PostgreSQL) ──────────────────────────────────────────
# Production Database URL (Neon PostgreSQL or Supabase)
DATABASE_URL=postgres://user:password@host/neondb?sslmode=require
# Isolated Test Database URL — MUST NOT point to production!
# Use local PostgreSQL (e.g. postgresql://postgres:postgres@localhost:5432/digital_twin_test)
# or a dedicated isolated Neon test branch/project.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/digital_twin_test
DB_POOL_MAX=15
DB_IDLE_TIMEOUT_MS=10000
DB_CONNECTION_TIMEOUT_MS=5000
DB_SSL_OFF=false

# Supabase API (Optional for direct client/Edge integrations)
SUPABASE_URL=https://[YOUR_PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ── 3. Security Secrets & Cryptography ────────────────────────────────────────
JWT_ACCESS_SECRET=your_super_secure_jwt_access_secret_key_here_32_bytes_long
JWT_REFRESH_SECRET=your_super_secure_jwt_refresh_secret_key_here_32_bytes_long
# Server-side HMAC secret for keyed cryptographic OTP verification (prevents offline brute-force/rainbow tables)
OTP_SECRET=your_super_secure_otp_hmac_secret_key_here_32_bytes_long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
COOKIE_SECURE=true
CORS_ORIGINS=https://digitaltwinvrs.com,https://www.digitaltwinvrs.com

# ── 4. Razorpay Live Payment Gateway ──────────────────────────────────────────
# Get this from Razorpay Dashboard -> Settings -> API Keys -> Live Mode
RAZORPAY_KEY_ID=rzp_live_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# ── 5. Brevo Automated Email SMTP ─────────────────────────────────────────────
# Get this from Brevo Dashboard -> SMTP & API -> API Keys
BREVO_API_KEY=xkeysib-your_brevo_api_key_here

# ── 6. AI Advisor Engine Config ("Ask AI for Study Plan") ─────────────────────
# AI_PROVIDER can be 'auto', 'openai', or 'anthropic'
AI_PROVIDER=auto
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ── 7. Optional File Storage & Cloud Services ─────────────────────────────────
FILE_STORAGE=local
UPLOAD_DIR=uploads
SENTRY_DSN=
